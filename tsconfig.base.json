{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@trde/core": ["./packages/core/src"],
      "@trde/ui-tokens": ["./packages/ui-tokens/src"],
      "@trde/mock-db": ["./packages/mock-db/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
